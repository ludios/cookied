{
	"name": "cookied",
	"description": "PostgreSQL-backed authentication for Node.js-based web applications",
	"version": "6.2.1",
	"scripts": {
		"build": "./node_modules/.bin/tsc -p tsconfig.build.json",
		"test": "./node_modules/.bin/vitest run --dir lib && ./node_modules/.bin/tsc --noEmit && ../../node_modules/.bin/oxlint .",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write ."
	},
	"type": "module",
	"exports": {
		"./*": "./dist/*"
	},
	"typesVersions": {
		"*": {
			"*": [
				"dist/*"
			]
		}
	},
	"engines": {
		"node": ">=24.7.0"
	},
	"dependencies": {
		"ayy": "^5.0.1"
	},
	"peerDependencies": {
		"@logtape/logtape": "^2.2.1",
		"@sveltejs/kit": "^2.0.5 || ^3.0.0",
		"postgres": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.1",
		"fast-check": "^4.10.2",
		"hash-wasm": "^4.12.0",
		"postgres": "github:ludios/postgres#prime",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"vitest": "4.1.9"
	}
}
