{
	"name": "demo",
	"description": "Demo site for showing that cookied actually works",
	"version": "0.0.1",
	"scripts": {
		"dev": "./dev/serve",
		"build": "vite build",
		"preview": "vite preview",
		"test": "./node_modules/.bin/svelte-kit sync && ./node_modules/.bin/tsc -p tsconfig.json --noEmit && ../../node_modules/.bin/oxlint .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write ."
	},
	"type": "module",
	"dependencies": {
		"cookied": "workspace:^",
		"postgres": "github:ludios/postgres#prime"
	},
	"devDependencies": {
		"@logtape/logtape": "^2.4.2",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	}
}
